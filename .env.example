# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser enviado ao GitHub.

# Banco de dados
DB_NAME=marketflow
DB_USER=marketflow
DB_PASSWORD=troque-esta-senha

# Chave para assinar os tokens JWT (gere uma aleatoria, veja o README)
JWT_SECRET=troque-por-uma-chave-aleatoria

# Primeiro administrador, criado na inicializacao
ADMIN_EMAIL=admin@marketflow.com
ADMIN_PASSWORD=troque-esta-senha

# Opcionais
# DB_HOST=localhost
# DB_PORT=5432
# DB_URL=jdbc:postgresql://host:5432/banco?sslmode=require
# PEDIDO_EXPIRACAO_MINUTOS=30
# PORT=8080
